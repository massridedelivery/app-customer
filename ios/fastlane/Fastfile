require "base64"
require "fileutils"

default_platform(:ios)

TEAM_ID = "Q7742Z74Q3"

platform :ios do
  desc "Build the prod flavor (com.massdrive.customerApp) and upload to TestFlight"
  lane :beta do
    build_and_upload(
      app_identifier: "com.massdrive.customerApp",
      scheme: "prod",
      configuration: "Release-prod",
    )
  end

  desc "Build the dev flavor (com.massdrive.customerApp.develop) and upload to TestFlight"
  lane :dev do
    build_and_upload(
      app_identifier: "com.massdrive.customerApp.develop",
      scheme: "dev",
      configuration: "Release-dev",
    )
  end

  # Shared archive + upload for both flavors. Each flavor has its own
  # match-managed App Store profile ("match AppStore <app_identifier>"), both
  # signed by the same Q7742Z74Q3 Apple Distribution cert.
  private_lane :build_and_upload do |options|
    app_identifier = options[:app_identifier]
    scheme         = options[:scheme]
    configuration  = options[:configuration]
    profile_name   = "match AppStore #{app_identifier}"

    # Creates a temporary keychain on CI and makes match import into it.
    # No-op on a normal developer machine.
    setup_ci

    # match READ-ONLY: pull the distribution cert + App Store profile from the
    # match git repo. No api_key on purpose — readonly match only reads the git
    # repo (auth via MATCH_GIT_BASIC_AUTHORIZATION), so it never invokes
    # spaceship, which crashes signing the App Store Connect JWT on the runner's
    # OpenSSL 3 with "invalid curve name (OpenSSL::PKey::ECError)".
    match(
      type: "appstore",
      readonly: true,
      app_identifier: [app_identifier],
    )

    # The project ships with automatic signing; force manual signing against the
    # match-managed profile so the archive is reproducible on CI. Scoped to this
    # flavor's build configuration only, and deliberately WITHOUT
    # bundle_identifier so the project's "com.massdrive.customerApp$(BUNDLE_ID_SUFFIX)"
    # pattern is left intact.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: TEAM_ID,
      targets: ["Runner"],
      build_configurations: [configuration],
      profile_name: profile_name,
      code_sign_identity: "Apple Distribution",
    )

    # Archive + export. The Dart/Flutter layer is compiled by the Xcode build
    # phase; `flutter build ios --config-only` in CI has already written the
    # dart-defines, version name and build number into Generated.xcconfig.
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: scheme,
      configuration: configuration,
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          app_identifier => profile_name,
        },
      },
    )

    # Upload with altool, not pilot/upload_to_testflight: altool signs the App
    # Store Connect API JWT natively (not through Ruby's OpenSSL), dodging the
    # same spaceship OpenSSL 3 curve crash. Materialize the .p8 from the base64
    # secret into the location altool looks in first.
    key_id    = ENV["ASC_KEY_ID"]
    issuer_id = ENV["ASC_ISSUER_ID"]
    key_dir   = File.expand_path("~/.appstoreconnect/private_keys")
    FileUtils.mkdir_p(key_dir)
    File.write(
      File.join(key_dir, "AuthKey_#{key_id}.p8"),
      Base64.decode64(ENV["ASC_KEY_P8_BASE64"]),
    )

    ipa_path = lane_context[SharedValues::IPA_OUTPUT_PATH]
    sh("xcrun altool --upload-app --type ios -f '#{ipa_path}' " \
       "--apiKey #{key_id} --apiIssuer #{issuer_id}")
  end
end
