default_platform(:android)

platform :android do
  desc "Upload an AAB to a Google Play track.\n" \
       "Options: aab: <path> (or AAB_PATH env), track: <internal|alpha|beta|production> " \
       "(default internal), status: <completed|draft|inProgress|halted> (default completed)."
  lane :deploy do |options|
    aab    = options[:aab] || ENV["AAB_PATH"]
    track  = options[:track] || "internal"
    status = options[:status] || "completed"

    UI.user_error!("No AAB path given (pass aab: or set AAB_PATH)") if aab.nil? || aab.empty?
    UI.user_error!("AAB not found at #{aab} — run `make build_aab_dev` first") unless File.exist?(aab)

    UI.message("Uploading #{aab} → track '#{track}' (#{status})")

    # package_name + json_key come from the Appfile. We only ship the binary;
    # the store listing / screenshots / changelog stay managed in the console.
    upload_to_play_store(
      track: track,
      aab: aab,
      release_status: status,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true,
      # Default Google-API timeout is 300s; the ~48MB AAB's prepare/upload step
      # intermittently exceeds it (first attempt fails, retry succeeds). Give it
      # more room. Overridable via `timeout:` option.
      timeout: (options[:timeout] || 900).to_i,
    )
  end

  desc "Promote an existing Play release to another track — no re-upload.\n" \
       "Google rejects a reused versionCode, so a build already on internal is\n" \
       "moved between tracks rather than uploaded again.\n" \
       "Options: version_code: <int> (required, or VERSION_CODE env), " \
       "to: <alpha|beta|production> (default production), " \
       "from: <track> (default internal), " \
       "status: <completed|draft|halted|inProgress> (default draft)."
  lane :promote do |options|
    version_code = options[:version_code] || ENV["VERSION_CODE"]
    if version_code.nil? || version_code.to_s.empty?
      UI.user_error!("No version_code given (pass version_code: or set VERSION_CODE)")
    end
    from   = options[:from]   || "internal"
    to     = options[:to]     || "production"
    status = options[:status] || "draft"

    UI.message("Promoting versionCode #{version_code}: #{from} → #{to} (#{status})")

    # package_name + json_key come from the Appfile. Nothing is uploaded — we
    # only move the existing release; status:draft leaves the final publish +
    # rollout % to a human in the Play Console.
    upload_to_play_store(
      track: from,
      track_promote_to: to,
      track_promote_release_status: status,
      version_code: version_code.to_i,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true,
      timeout: (options[:timeout] || 900).to_i,
    )
  end

  desc "Verify the Play service-account JSON authenticates for this package."
  lane :whoami do
    validate_play_store_json_key
    UI.success("Service-account JSON is valid for #{CredentialsManager::AppfileConfig.try_fetch_value(:package_name)}")
  end
end
